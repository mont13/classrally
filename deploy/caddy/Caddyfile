# ClassRally — Caddy reverse proxy configuration
#
# Caddy obtains and renews Let's Encrypt certificates automatically.
# The site address is taken from CLASSRALLY_DOMAIN (environment of the caddy
# container, see deploy/docker-compose.web.yml), e.g. classrally.example.com.
#
# Usage:
#   CLASSRALLY_DOMAIN=classrally.example.com QUIZ_ADMIN_PASSWORD=... \
#     docker compose -f docker-compose.yml -f deploy/docker-compose.web.yml up -d
#
# Make sure DNS for the domain points to this server and ports 80/443 are open.

{$CLASSRALLY_DOMAIN} {
	encode gzip

	header Strict-Transport-Security "max-age=31536000"

	# No caching headers here on purpose: the host screen polls /api/state
	# every second and the app does not mark its responses cacheable.

	# "classrally" is the Docker service name; 48217 is the app port.
	# WebSocket upgrades (/api/ws) are proxied automatically. Caddy sets
	# X-Forwarded-For/-Proto/-Host itself and replaces a client-supplied
	# X-Forwarded-For (the app uses its leftmost entry for login rate limiting).
	reverse_proxy classrally:48217 {
		transport http {
			dial_timeout 5s
		}
	}
}

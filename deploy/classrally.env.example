# ClassRally — server configuration template (docs/NASAZENI.md)
#
# Copy OUTSIDE the git checkout and restrict access, e.g.:
#   systemd: /etc/classrally/classrally.env   (root:classrally, mode 640)
#   Docker:  /etc/classrally/classrally.env   (root, mode 600)
# One VAR=value per line; no inline comments (systemd would keep them in the value).

# Public address (QR codes and links for students)
QUIZ_BASE_URL=https://classrally.example.com

# Password for /admin. Generate e.g.: openssl rand -base64 24
# Without it /admin is open to anyone until the first teacher registers.
QUIZ_ADMIN_PASSWORD=

# Port the app listens on (systemd variant; Docker uses CLASSRALLY_PORT below)
QUIZ_PORT=48217

# Who may set X-Forwarded-For (your reverse proxy); comma-separated IPs/CIDRs.
# Must be the address the app sees the proxy connect from:
#   systemd + proxy on the same machine:  127.0.0.1
#   Docker + proxy on the same machine:   172.17.0.1 (docker0) — or leave empty
#   proxy on another machine:             that machine's IP
# Empty = all private ranges are trusted. A wrong value makes all clients share
# one login rate limit (5 failed attempts would lock out everyone for 5 min).
QUIZ_TRUSTED_PROXIES=

# Several teachers on one server: multi gives every teacher a room with a
# 6-digit PIN (students enter it when joining) and keeps each teacher's games,
# homework, classes, students and own question banks separate.
# single (default) = one shared game, as on a classroom laptop.
QUIZ_ROOMS=single

# Outgoing e-mail: password reset, e-mail confirmation, teacher invitations.
# log (default) only writes messages to data/outbox; live sends via SMTP.
MAIL_MODE=log
# MAIL_FROM=ClassRally <classrally@example.com>
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=classrally@example.com
# SMTP_PASSWORD=

# Optional: AI question generation (Ollama or an OpenAI-compatible API).
# When AI_BASE_URL is set here, teachers can only choose the model and the
# API key never leaves the server.
# AI_BASE_URL=http://localhost:11434
# AI_API_KEY=
# AI_MODEL=gpt-oss:20b

# Optional bug reports to a central collector (see bugreport.py). Pages post to
# this server, which forwards to BUGGY_URL with the project key; the widget files
# (widget.js, widget.css, capture.css) go to BUGGY_WIDGET_DIR — in Docker
# variant B to CLASSRALLY_DATA_DIR/buggy. Leave unset to keep reporting off.
# BUGGY_URL=https://bugs.example.com
# BUGGY_PROJECT_KEY=classrally
# BUGGY_ORIGIN=https://classrally.example.com
# BUGGY_WIDGET_DIR=/srv/classrally/buggy

# Docker + Caddy variant (deploy/docker-compose.web.yml):
# CLASSRALLY_DOMAIN=classrally.example.com

# Docker variants (A: docker-compose.web.yml, B: docker-compose.server.yml):
# CLASSRALLY_UID=
# CLASSRALLY_GID=

# Docker variant B only (deploy/docker-compose.server.yml):
# CLASSRALLY_BIND_ADDR=127.0.0.1
# CLASSRALLY_PORT=48217
# CLASSRALLY_DATA_DIR=/srv/classrally
